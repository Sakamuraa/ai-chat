# Salin ke .env.local lalu isi nilainya dari dashboard Vercel (project ai-chat).
# .env.local hilang saat repo lokal sempat terhapus (2026-09-27) — tanpa file ini:
#   - dev server lokal tak bisa jalan
#   - scripts/exec-server-wrapper.sh gagal (EXEC_KEY wajib) -> watchdog exec.onheil.fun selalu "Mati"
# Nilai di bawah = placeholder, JANGAN dibiarkan saat menjalankan sidecar.

# --- wajib utk sidecar exec (tool run_command) ---
EXEC_KEY=
EXEC_BASE=https://exec.onheil.fun

# --- wajib utk app ---
DATABASE_URL=
GATEWAY_BASE=
GATEWAY_KEY=
AUTH_CALLBACK_ORIGIN=https://ai.onheil.fun
NEXT_PUBLIC_SITE_URL=https://ai.onheil.fun

# --- opsional ---
TITLE_MODEL=
DAILY_TOKEN_LIMIT=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_USER=
SMTP_PASS=
GMAIL_APP_PASSWORD=
